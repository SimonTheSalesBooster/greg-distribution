# Greg Distribution Advisor -- Required API Keys
# Copy this file to ~/.claude/.env and fill in your values

# Obsidian vault path (for task queue and scorecard)
OBSIDIAN_VAULT="/path/to/your/vault"

# Discord webhooks (for notifications)
DISCORD_WEBHOOK_AGENTS="https://discord.com/api/webhooks/..."
DISCORD_WEBHOOK_USER_BRAG="https://discord.com/api/webhooks/..."
DISCORD_WEBHOOK_ALERTS="https://discord.com/api/webhooks/..."

# Google Analytics (for AI referral tracking -- Strategy 4)
GA4_PROPERTY_ID="your-ga4-property-id"

# Google OAuth (for GA4 API access)
GOOGLE_CLIENT_ID="your-client-id"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REFRESH_TOKEN="your-refresh-token"

# Notion (for content pipeline via Refinery DB)
NOTION_TOKEN="your-notion-token"
REFINERY_DB_ID="your-refinery-database-id"
